# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma separated origins allowed by CORS (mobile apps are not affected by CORS; this is for the web client)
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# ---- Database (MongoDB) ----
# Local:  mongodb://127.0.0.1:27017/docuflow
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/docuflow
MONGO_URI=mongodb://127.0.0.1:27017/docuflow

# ---- Auth ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Cloudinary (https://cloudinary.com/console) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Python OCR / classification service ----
PYTHON_SERVICE_URL=http://localhost:8000
# Must match PYTHON_SERVICE_KEY in python-service/.env (leave both empty to disable)
PYTHON_SERVICE_KEY=

# ---- Email (NodeMailer) - password-reset codes and expiry alerts ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="DocuFlow <no-reply@docuflow.local>"

# ---- Documents / expiry ----
MAX_UPLOAD_MB=10
# Default "Expiring Soon" window (each user can change theirs in Profile)
EXPIRY_WARNING_DAYS=30
# Reminder schedule used by the notification engine (days before expiry)
NOTIFICATION_SCHEDULE_DAYS=90,30,7,1

# ---- Public URL / HTTPS (used for secure share links) ----
# The address people reach this API on (no trailing slash). Use your https:// domain in production.
PUBLIC_URL=http://localhost:5000
# Set both to true when deployed behind a TLS-terminating proxy (Render, Railway, Nginx ...)
TRUST_PROXY=false
FORCE_HTTPS=false

# ---- Notification engine ----
NOTIFICATION_SCAN_MINUTES=60
# Do not send "expired" alerts for documents that expired longer ago than this
EXPIRED_NOTIFY_GRACE_DAYS=30
