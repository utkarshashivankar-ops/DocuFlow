# Port the Python service listens on
PORT=8000

# Optional shared secret. If set, Node must send it as header X-Service-Key
PYTHON_SERVICE_KEY=

# Windows: full path to Tesseract OCR executable
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Tesseract language(s)
TESSERACT_LANG=eng

# Maximum PDF pages to process
MAX_PDF_PAGES=5

# Maximum upload size in MB
MAX_UPLOAD_MB=15