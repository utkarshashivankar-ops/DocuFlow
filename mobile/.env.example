# URL of the DocuFlow backend (NO trailing /api).
#  - Android emulator:      http://10.0.2.2:5000
#  - Physical phone (Expo Go): http://<your-PC-LAN-IP>:5000   e.g. http://192.168.1.12:5000
#    (phone and PC must be on the same Wi-Fi; find the IP with `ipconfig` on Windows)
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
